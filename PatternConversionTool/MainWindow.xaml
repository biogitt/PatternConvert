<Window x:Class="PatternConversionTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PatternConversionTool.ViewModels"
        mc:Ignorable="d"
        Title="STIL Pattern Conversion Tool" Height="680" Width="1050"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Signal display area (~60% of the available vertical space) -->
            <RowDefinition Height="3*"/>
            <!-- Program running status area (~40%) -->
            <RowDefinition Height="2*"/>
            <!-- Conversion progress area (fixed small height) -->
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <Button Content="Load STIL"  Command="{Binding LoadStilCommand}"  Width="100" Margin="0,0,5,0"/>
            <Button Content="Load CSV"   Command="{Binding LoadCsvCommand}"   Width="100" Margin="0,0,5,0"/>
            <Button Content="Export CSV"  Command="{Binding ExportCsvCommand}" Width="100" Margin="0,0,5,0"/>
            <Button Content="Generate"   Command="{Binding GenerateCommand}"  Width="100" Margin="0,0,5,0"
                    FontWeight="Bold"/>
        </StackPanel>

        <!-- Signal DataGrid -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Signals}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserSortColumns="True"
                  SelectionMode="Extended">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Signal Name" Width="150"
                    Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Direction" Width="80"
                    Binding="{Binding Direction}" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="Enabled" Width="65"
                    Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Group" Width="100"
                    Binding="{Binding Group, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="Source" Width="70"
                    Binding="{Binding Source}" IsReadOnly="True"/>
                <DataGridTextColumn Header="STIL Name" Width="150"
                    Binding="{Binding OriginalStilName}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Program running status area: scrollable, log-style history -->
        <GroupBox Grid.Row="2" Header="Program Running Status" Margin="0,6,0,0">
            <TextBox x:Name="StatusLogBox"
                     Text="{Binding StatusLog, Mode=OneWay}"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     Background="#FFFAFAFA"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextChanged="StatusLogBox_TextChanged"/>
        </GroupBox>

        <!-- Conversion progress area (bottom, fixed small height) -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Generation progress bar with "line xxx/xxxx" label -->
            <ProgressBar Grid.Column="0" Height="18" VerticalAlignment="Center"
                         Minimum="0"
                         Maximum="{Binding ProgressMaximum}"
                         Value="{Binding ProgressValue}"
                         Visibility="{Binding ProgressVisible,
                             Converter={StaticResource BoolToVisibility}}"/>

            <TextBlock Grid.Column="1" Text="{Binding ProgressText}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" MinWidth="140" TextAlignment="Right"
                       Visibility="{Binding ProgressVisible,
                           Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</Window>

